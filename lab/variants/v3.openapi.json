{
  "openapi": "3.0.3",
  "info": {
    "title": "Willow Retail Bank synthetic collections tools",
    "version": "1.0.0",
    "description": "Synthetic benchmark contract only; not a claim that the public mock implements this variant. Seven tool names and paths match the public interface. customer_id identifies the call. The agent must enforce the brief; the tools do not enforce payment dates, amounts or outcome precedence."
  },
  "servers": [
    {
      "url": "https://freya-bank-mock.freyavoice.workers.dev/v1"
    }
  ],
  "components": {},
  "paths": {
    "/verify_identity": {
      "post": {
        "summary": "Check one security answer. 3 wrong answers in total end the check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "date_of_birth",
                      "phone_last4"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "description": "date_of_birth: YYYY-MM-DD; unreadable dates return ok=false without consuming a wrong answer. phone_last4: exactly four digits including leading zeroes. day_month_swapped is a non-counting hint; ask for the month as a word."
                  }
                },
                "required": [
                  "customer_id",
                  "field",
                  "answer"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "wrong_answers_left": {
                      "type": "integer",
                      "description": "Remaining incorrect answers across both questions. A hint or malformed input does not reduce this count."
                    },
                    "all_verified": {
                      "type": "boolean"
                    },
                    "hint": {
                      "type": "string",
                      "enum": [
                        "day_month_swapped"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "verify_identity"
      }
    },
    "/get_account": {
      "post": {
        "summary": "The late products. Refused until both questions are passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "personal_loan"
                            ]
                          },
                          "overdue_balance": {
                            "type": "number",
                            "exclusiveMinimum": true,
                            "minimum": 0,
                            "description": "Overdue balance in pounds."
                          },
                          "days_late": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 40
                          },
                          "scheduled_payment": {
                            "type": "number",
                            "minimum": 0,
                            "exclusiveMinimum": true,
                            "description": "Required for personal_loan; its scheduled payment in pounds. Never greater than overdue_balance."
                          }
                        },
                        "required": [
                          "product_id",
                          "type",
                          "overdue_balance",
                          "days_late"
                        ],
                        "oneOf": [
                          {
                            "properties": {
                              "type": {
                                "enum": [
                                  "personal_loan"
                                ]
                              }
                            },
                            "required": [
                              "scheduled_payment"
                            ]
                          }
                        ]
                      },
                      "minItems": 1,
                      "maxItems": 1,
                      "description": "Account order is negotiation and closing-priority order."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "get_account"
      }
    },
    "/create_promise": {
      "post": {
        "summary": "Record a payment promise. One per product.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "amount",
                  "date"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "promise_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "create_promise"
      }
    },
    "/add_note": {
      "post": {
        "summary": "Available in the common API, but this single-product campaign must never call it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "declined_payment",
                      "needs_care",
                      "account_disputed",
                      "paid_claim",
                      "promise_unavailable"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "add_note"
      }
    },
    "/schedule_callback": {
      "post": {
        "summary": "Book a callback.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "time": {
                    "type": "string",
                    "description": "HH:MM"
                  }
                },
                "required": [
                  "customer_id",
                  "date",
                  "time"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "schedule_callback"
      }
    },
    "/transfer_to_agent": {
      "post": {
        "summary": "Hand the call to a person.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "queue": {
                    "type": "string",
                    "enum": [
                      "loan_options",
                      "customer_adviser",
                      "wellbeing"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "queue"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "transfer_to_agent"
      }
    },
    "/close_call": {
      "post": {
        "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "payment_agreed",
                      "payment_claimed",
                      "agent_connected",
                      "payment_unagreed",
                      "security_incomplete",
                      "customer_unavailable"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Omit for payment_agreed and payment_claimed; required otherwise. The brief's code table defines valid outcome/reason pairs.",
                    "enum": [
                      "declined_payment",
                      "needs_care",
                      "account_disputed",
                      "promise_unavailable",
                      "loan_review",
                      "adviser_requested",
                      "wellbeing_accepted",
                      "not_identified",
                      "callback_arranged",
                      "callback_not_arranged",
                      "wrong_contact",
                      "bereavement_report",
                      "answers_failed",
                      "questions_declined"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "outcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "close_call"
      }
    }
  }
}
