{
 "openapi": "3.0.3",
 "info": {"title": "Orchard Pizza", "version": "1.0"},
 "servers": [{"url": "https://wired-bank-mock.barisbayburtlu33.workers.dev"}],
 "paths": {
  "/pizza/menu": {"post": {
   "operationId": "get_menu", "summary": "Read the current pizza menu",
   "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"customer_ref": {"type": "string"}}, "required": ["customer_ref"]}}}},
   "responses": {"200": {"description": "Current menu", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"type": "string", "enum": ["available", "closed"]}, "items": {"type": "array", "items": {"type": "object", "properties": {"item_code": {"type": "string"}, "name": {"type": "string"}, "price_cents": {"type": "integer"}}, "required": ["item_code", "name", "price_cents"]}}}, "required": ["status", "items"]}}}}, "503": {"description": "Service unavailable"}}
  }},
  "/pizza/order": {"post": {
   "operationId": "place_order", "summary": "Place a customer-confirmed pizza order; never retry",
   "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"customer_ref": {"type": "string"}, "item_code": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1, "maximum": 4}}, "required": ["customer_ref", "item_code", "quantity"]}}}},
   "responses": {"200": {"description": "Order decision", "content": {"application/json": {"schema": {"type": "object", "properties": {"accepted": {"type": "boolean"}, "order_ref": {"type": "string"}, "reason": {"type": "string"}}, "required": ["accepted"]}}}}, "503": {"description": "Service unavailable"}}
  }}
 }
}
